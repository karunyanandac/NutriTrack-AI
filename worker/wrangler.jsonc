{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutritrack-ai-proxy",
  "main": "src/index.js",
  "compatibility_date": "2025-03-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://karunyanandac.github.io"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ]
}
